{
  "SPDX-FileCopyrightText": "2026 roolrz",
  "SPDX-License-Identifier": "Apache-2.0",
  "version": 1,
  "name": "lib-clap",
  "kind": "library",
  "tests": [
    [
      "make",
      "component-check",
      "APP_TEST_PACKAGE=hyper-clap-shared"
    ]
  ],
  "cargo": [
    {
      "manifest": "Cargo.toml",
      "domain": "system",
      "shared": true,
      "features": [
        "derive"
      ],
      "default_features": false,
      "link_probe": "tests/link/Cargo.toml"
    }
  ],
  "artifacts": [
    {
      "library": "libhyper_clap_shared.so",
      "staged": "lib/libhyper_clap_shared.so",
      "destination": "lib64/{arch}-hyper-hyper/libhyper_clap_shared.so",
      "mode": "0755",
      "profiles": [
        "system",
        "development",
        "io"
      ],
      "rust_runtime": "std",
      "environment": "system",
      "manifest": "Cargo.toml"
    }
  ],
  "build": {
    "type": "native-rust",
    "requires": [
      "toolchain"
    ]
  }
}
